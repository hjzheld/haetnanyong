{
  "name": "personal-schedule-reminder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "lint": "nuxt typecheck",
    "test:audit": "node scripts/check-audit.mjs",
    "test:reminders": "node scripts/check-reminders.mjs && node scripts/check-slack-oauth.mjs",
    "test:workspace": "node scripts/check-calendar.mjs && node scripts/check-dashboard.mjs && node scripts/check-locales.mjs",
    "test:workspace:browser": "node scripts/check-workspace-ui.cjs",
    "test:plans:browser": "node scripts/check-plans-browser.cjs",
    "test:performance": "node scripts/check-performance.mjs && node scripts/check-account.mjs && node scripts/check-calendar-dates.mjs && node scripts/check-calendar.mjs && node scripts/check-reveal.mjs",
    "test:performance:browser": "node scripts/check-performance-browser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nuxt": "^11.8.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vue-tsc": "^3.3.13"
  }
}
